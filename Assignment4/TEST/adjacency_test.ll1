; ============================================================================
; Test per LoopFusionPass: verifica SOLO il controllo di adiacenza
; (canFuse, allo stato attuale, controlla solo stesso parent-loop + areAdjacent)
;
; @adjacent_loops     -> i due loop SONO adiacenti  (loop0.exit == loop1.preheader)
; @not_adjacent_loops -> i due loop NON sono adiacenti (blocco extra fra i due)
;
; Esecuzione:
;   opt -load-pass-plugin=./LoopFusionPass.so -passes=loop-fusion-pass \
;       -disable-output adjacency_test.ll
;
; Output atteso:
;   Analizzo possibile fusione tra: loop0 e loop1
;   I loop possono essere fusi              <- solo per @adjacent_loops
;   Analizzo possibile fusione tra: loop0 e loop1   <- per @not_adjacent_loops,
;                                              senza la riga "possono essere fusi"
; ============================================================================

define void @adjacent_loops(ptr %A, ptr %B, i64 %N) {
entry:
  br label %loop0.preheader

loop0.preheader:
  br label %loop0

loop0:
  %i0 = phi i64 [ 0, %loop0.preheader ], [ %i0.next, %loop0 ]
  %gep0 = getelementptr inbounds i32, ptr %A, i64 %i0
  store i32 0, ptr %gep0
  %i0.next = add i64 %i0, 1
  %cond0 = icmp slt i64 %i0.next, %N
  br i1 %cond0, label %loop0, label %loop0.exit

loop0.exit:
  br label %loop1.preheader

loop1.preheader:
  br label %loop1

loop1:
  %i1 = phi i64 [ 0, %loop1.preheader ], [ %i1.next, %loop1 ]
  %gep1 = getelementptr inbounds i32, ptr %B, i64 %i1
  store i32 1, ptr %gep1
  %i1.next = add i64 %i1, 1
  %cond1 = icmp slt i64 %i1.next, %N
  br i1 %cond1, label %loop1, label %loop1.exit

loop1.exit:
  ret void
}

define void @not_adjacent_loops(ptr %A, ptr %B, i64 %N) {
entry:
  br label %loop0.preheader

loop0.preheader:
  br label %loop0

loop0:
  %i0 = phi i64 [ 0, %loop0.preheader ], [ %i0.next, %loop0 ]
  %gep0 = getelementptr inbounds i32, ptr %A, i64 %i0
  store i32 0, ptr %gep0
  %i0.next = add i64 %i0, 1
  %cond0 = icmp slt i64 %i0.next, %N
  br i1 %cond0, label %loop0, label %loop0.exit

loop0.exit:
  call void @sideEffect()
  br label %mid

mid:
  br label %loop1.preheader

loop1.preheader:
  br label %loop1

loop1:
  %i1 = phi i64 [ 0, %loop1.preheader ], [ %i1.next, %loop1 ]
  %gep1 = getelementptr inbounds i32, ptr %B, i64 %i1
  store i32 1, ptr %gep1
  %i1.next = add i64 %i1, 1
  %cond1 = icmp slt i64 %i1.next, %N
  br i1 %cond1, label %loop1, label %loop1.exit

loop1.exit:
  ret void
}

declare void @sideEffect()
